<?xml version="1.0" encoding="UTF-8"?>
<!--
  一般建置沒有任何相依套件；不使用 Maven 時請用 build.bat / run.bat。
  GitHub Pages 靜態網站：mvn -P pages process-classes，輸出到 target/pages
  （TeaVM 把 Java 試算程式編譯成 js/engine.js，只在建置時使用，不會加進伺服器版）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.fullmoney</groupId>
  <artifactId>fullcalmoney</artifactId>
  <version>2.1.0</version>
  <packaging>jar</packaging>
  <name>FullMoney 理財試算</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <teavm.version>0.16.0</teavm.version>
    <pages.directory>${project.build.directory}/pages</pages.directory>
  </properties>

  <build>
    <finalName>fullcalmoney</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.fullmoney.WebApp</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>pages</id>
      <dependencies>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-classlib</artifactId>
          <version>${teavm.version}</version>
          <scope>provided</scope>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-jso</artifactId>
          <version>${teavm.version}</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <!-- 瀏覽器端引擎的原始碼另外放在 src/pages/java -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>add-pages-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/pages/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- 網頁檔複製到 target/pages；js/engine.js 由 TeaVM 產生，不複製伺服器版的空殼 -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>copy-pages</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${pages.directory}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>src/main/resources/static</directory>
                      <excludes>
                        <exclude>js/engine.js</exclude>
                      </excludes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-maven-plugin</artifactId>
            <version>${teavm.version}</version>
            <executions>
              <execution>
                <id>browser-engine</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>compile</goal>
                </goals>
                <configuration>
                  <mainClass>com.fullmoney.pages.BrowserEngine</mainClass>
                  <targetType>JAVASCRIPT</targetType>
                  <jsModuleType>ES2015</jsModuleType>
                  <targetDirectory>${pages.directory}/js</targetDirectory>
                  <targetFileName>engine.js</targetFileName>
                  <optimizationLevel>ADVANCED</optimizationLevel>
                  <minifying>true</minifying>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
